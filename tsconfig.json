{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "noUncheckedIndexedAccess": true,
    "outDir": "./dist",

    "rootDir": "./src",
    "skipLibCheck": true,
    "sourceMap": true,

    "strict": true,
    "target": "ES2022"
  },

  "exclude": ["node_modules", "dist", "tests"],

  "include": ["src/**/*.ts"]
}
